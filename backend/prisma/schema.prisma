datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  name            String?   @db.VarChar(255)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  apiKeys        ApiKey[]
  githubConfig   GithubConfig?
  roadmaps       Roadmap[]
  progressEvents ProgressEvent[]
  submissions    Submission[]
  sessions       Session[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @default("cos-leet Extension") @db.VarChar(100)
  keyHash    String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix  String    @map("key_prefix") @db.VarChar(32)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamp(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model GithubConfig {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  githubUsername       String    @map("github_username") @db.VarChar(100)
  githubRepo           String    @map("github_repo") @db.VarChar(255)
  githubBranch         String    @default("main") @map("github_branch") @db.VarChar(100)
  accessTokenEncrypted String    @map("access_token_encrypted") @db.Text
  isConfigured         Boolean   @default(false) @map("is_configured")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamp(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_configs")
}

enum RoadmapStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Roadmap {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  title        String        @db.VarChar(255)
  sourceType   String        @map("source_type") @db.VarChar(50)
  sourceUrl    String?       @map("source_url") @db.Text
  status       RoadmapStatus @default(COMPLETED)
  errorMessage String?       @map("error_message") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapProblems RoadmapProblem[]

  @@index([userId])
  @@index([sourceUrl])
  @@index([status])
  @@map("roadmaps")
}

enum Difficulty {
  UNKNOWN
  EASY
  MEDIUM
  HARD
}

model Problem {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonicalSlug     String     @unique @map("canonical_slug") @db.VarChar(255)
  title             String     @db.VarChar(255)
  difficulty        Difficulty @default(UNKNOWN)
  platform          String?    @db.VarChar(100)
  externalUrl       String?    @map("external_url") @db.Text
  platformProblemId String?    @map("platform_problem_id") @db.VarChar(100)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  roadmapProblems RoadmapProblem[]
  progressEvents  ProgressEvent[]
  submissions     Submission[]

  @@index([canonicalSlug])
  @@map("problems")
}

model RoadmapProblem {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadmapId          String     @map("roadmap_id") @db.Uuid
  problemId          String     @map("problem_id") @db.Uuid
  topic              String     @db.VarChar(255)
  originalTitle      String     @map("original_title") @db.VarChar(255)
  originalUrl        String?    @map("original_url") @db.Text
  originalCategory   String?    @map("original_category") @db.VarChar(255)
  originalDifficulty Difficulty @default(UNKNOWN) @map("original_difficulty")
  orderIndex         Int        @default(0) @map("order_index")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamp(6)

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, problemId])
  @@index([roadmapId])
  @@index([problemId])
  @@map("roadmap_problems")
}

enum ProgressStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
  REVISE
}

enum LlmStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GithubSyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  SKIPPED
}

model ProgressEvent {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  problemId String         @map("problem_id") @db.Uuid
  status    ProgressStatus @default(NOT_STARTED)
  aiNotes   String?        @map("ai_notes") @db.Text
  solvedAt  DateTime?      @map("solved_at") @db.Timestamp(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem    Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submission Submission?

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
  @@map("progress_events")
}

model Submission {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  problemId            String           @map("problem_id") @db.Uuid
  progressEventId      String           @unique @map("progress_event_id") @db.Uuid
  code                 String           @db.Text
  codeHash             String           @map("code_hash") @db.VarChar(64)
  language             String           @db.VarChar(50)
  runtime              String?          @db.VarChar(50)
  memory               String?          @db.VarChar(50)
  externalSubmissionId String?          @map("external_submission_id") @db.VarChar(100)
  llmStatus            LlmStatus        @default(PENDING) @map("llm_status")
  annotatedCode        String?          @map("annotated_code") @db.Text
  timeComplexity       String?          @map("time_complexity") @db.VarChar(100)
  spaceComplexity      String?          @map("space_complexity") @db.VarChar(100)
  llmProcessedAt       DateTime?        @map("llm_processed_at") @db.Timestamp(6)
  githubSyncStatus     GithubSyncStatus @default(PENDING) @map("github_sync_status")
  githubRepo           String?          @map("github_repo") @db.VarChar(255)
  githubFilePath       String?          @map("github_file_path") @db.VarChar(500)
  githubFileSha        String?          @map("github_file_sha") @db.VarChar(100)
  githubCommitSha      String?          @map("github_commit_sha") @db.VarChar(100)
  githubSyncedAt       DateTime?        @map("github_synced_at") @db.Timestamp(6)
  syncError            String?          @map("sync_error") @db.Text
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem       Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  progressEvent ProgressEvent @relation(fields: [progressEventId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, githubSyncStatus])
  @@index([problemId])
  @@map("submissions")
}

model Session {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenFamily String   @map("token_family") @db.VarChar(255)
  hashedToken String   @unique @map("hashed_token") @db.VarChar(255)
  ipAddress   String?  @map("ip_address") @db.VarChar(255)
  userAgent   String?  @map("user_agent") @db.Text
  revoked     Boolean  @default(false)
  expiresAt   DateTime @map("expires_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@index([hashedToken])
  @@index([expiresAt])
  @@map("sessions")
}
